Mods: {
	ItemMagnetPlus: {
		Buffs: {
			ItemMagnetBuff: {
				DisplayName: Imán de Objetos
				Description: Un Campo Magnético te rodea!
				CurrentRange: Rango Actual: {0}
				CurrentVelocity: Velocidad Actual: {0}
				CurrentAcceleration: Aceleración Actual: {0}
			}
		}

		Items: {
			ItemMagnet: {
				DisplayName: Imán de Objetos
				CurrentRange: "{$Buffs.ItemMagnetBuff.CurrentRange}"
				CurrentVelocity: "{$Buffs.ItemMagnetBuff.CurrentVelocity}"
				CurrentAcceleration: "{$Buffs.ItemMagnetBuff.CurrentAcceleration}"
				LeftClickToChangeRange: Click Izquierdo para [c/{0}:alternar rango]
				LeftClickToToggle: Click Izquierdo para [c/{0}:activar/desactivar]
				RightClickToShowCurrentRange: Click Derecho para [c/{0}:mostrar el rango actual]
				RightClickToTurnOff: Right Click to [c/{0}:desactivar]
				MagnetIsOff: El Imán está desactivado
				MagnetOff: Imán desactivado
				Off: desactivado
				Range: rango: {0}
				NextRange: | siguiente: {0}
			}
		}

		Configs: {
			Config: {
				DisplayName: Configuración

				Headers: {
					PresetItemWhitelist: Lista blanca de objetos predefinidos
					CustomItemFilter: Filtro personalizado de Objetos
					General: General
					MagnetBehavior: Comportamiento del Imán (Funciona solo dentro del juego)
					ResultingMagnetStats: Estadistícas del Imán Resultante
				}

				Hearts: {
					Label: "[i:Heart] Corazones"
					Tooltip: Activa para permitir que el imán recoja corazones
				}

				ManaStars: {
					Label: "[i:Star] Estrellas de mana"
					Tooltip: Activa para permitir que el imán recoja estrellas de maná
				}

				Coins: {
					Label: "[i:GoldCoin] Monedas"
					Tooltip: Activa para permitir que el imán recoja monedas
				}

				PickupEffect: {
					Label: "[i:FragmentNebula] Atraer Objetos con efectos"
					Tooltip: Permite que objetos como los potenciadores de armadura nebula u objetos de mods como las notas musicales de Thorium, sean recogidas por el imán
				}

				Blacklist: {
					Label: Lista negra del Imán
					Tooltip: Elige qué objetos nunca recogerá el Imán
				}

				Whitelist: {
					Label: Lista blanca del Imán
					Tooltip: Elige que objetos siempre seran recogidos por el Imán
				}

				FilterListMode: {
					Label: Cambiar el tipo de Lista
					Tooltip: Cambia que tipo de lista es utilizada por el filtro de objetos
				}

				Buff: {
					Label: Potenciador
					Tooltip: Activa para obtener un potenciador al estar activo el Imán
				}

				Held: {
					Label: En mano
					Tooltip: Activa para que el Imán solo funcione cuando lo sostienes en mano (en lugar de estar en el inventario)
				}

				OnEnter: {
					Label: Activar al Entrar
					Tooltip: Activa para que el Imán se active automáticamente al entrar al mundo
				}

				NeedsSpace: {
					Label: Necesita Espacio
					Tooltip: Activa para que el Imán funcione solo cuando hay espacio en el inventario
				}

				Instant: {
					Label: Instantáneo
					Tooltip: Activa para que los objetos se teletransporten directamente en lugar de que sean atraídos - Ignora la velocidad/aceleración, pero no el rango
				}

				Range: {
					Label: Rango
					Tooltip: Radio base del Imán (en bloques)
				}

				Velocity: {
					Label: Velocidad
					Tooltip: Velocidad a la que los objetos son atraídos hacía tí
				}

				Acceleration: {
					Label: Aceleración
					Tooltip: Que tan rapido un objeto alcanza su velocidad máxima
				}

				ScaleMode: {
					Label: Escala
					Tooltip: Modo Escala
				}

				CurrentMaxRange: {
					Label: Rango Máximo Resultante
					Tooltip: ""
				}

				CurrentVelocity: {
					Label: Velocidad Resultante
					Tooltip: ""
				}

				CurrentAcceleration: {
					Label: Aceleración Resultante
					Tooltip: ""
				}
			}

			FilterListModeType: {
				Tooltip: ""
				Blacklist.Label: Lista Negra
				Whitelist.Label: Lista Blanca
			}

			ScaleModeType: {
				Tooltip: ""
				Bosses.Label: Incrementa con Jefes
				AlwaysMaxRange.Label: Jefes + Rango Máximo
				OnlyConfig.Label: Custom + Rango Máximo
			}
		}
	}
}
