Mods: {
  ItemMagnetPlus: {
    Buffs: {
      ItemMagnetBuff: {
        DisplayName: Gegenstandsmagnet
        Description: Ein Magnetfeld umgibt dich!
        CurrentRange: Aktuelle Reichweite: {0}
        CurrentVelocity: Aktuelle Geschwindigkeit: {0}
        CurrentAcceleration: Aktuelle Beschleunigung: {0}
      }
    }
    Items: {
      ItemMagnet: {
        DisplayName: Gegenstandsmagnet
        CurrentRange: "{$Buffs.ItemMagnetBuff.CurrentRange}"
        CurrentVelocity: "{$Buffs.ItemMagnetBuff.CurrentVelocity}"
        CurrentAcceleration: "{$Buffs.ItemMagnetBuff.CurrentAcceleration}"
        LeftClickToChangeRange: Linksklick, um [c/{0}:change range]
        LeftClickToToggle: Linksklick, um [c/{0}:toggle on/off]
        RightClickToShowCurrentRange: Rechtsklick, um [c/{0}:show current range]
        RightClickToTurnOff: Rechtsklick, um [c/{0}:turn off]
        MagnetIsOff: Magnet ist aus
        MagnetOff: Magnet aus
        Off: aus
        Range: Reichweite: {0}
        NextRange: | Nächste: {0}
      }
    }
    Configs: {
      Config: {
        Headers: {
          PresetItemWhitelist: Voreingestellte Gegenstand-Whitelist
          CustomItemFilter: Benutzerdefinierter Gegenstandsfilter
          General: Allgemein
          MagnetBehavior: Magnetverhalten (Funktioniert nur im Spiel)
          ResultingMagnetStats: Ergebniswerte des Magneten
        }
        Hearts: {
          Label: "[i:Heart] Herzen"
          Tooltip: Umschalten, ob Herzen vom Magneten eingesammelt werden sollen
        }
        ManaStars: {
          Label: "[i:Star] Manasterne"
          Tooltip: Umschalten, ob Manasterne vom Magneten eingesammelt werden sollen
        }
        Coins: {
          Label: "[i:GoldCoin] Münzen"
          Tooltip: Umschalten, ob Münzen vom Magneten eingesammelt werden sollen
        }
        PickupEffect: {
          Label: "[i:FragmentNebula] Aufhebeeffekt-Gegenstände"
          Tooltip: Umschalten, ob Gegenstände wie Nebula-Rüstungsbooster oder Mod-Gegenstände wie die Musiknoten aus Thorium vom Magneten eingesammelt werden sollen
        }
        Blacklist: {
          Label: Magnet-Blacklist
          Tooltip: Anpassen, welche Gegenstände der Magnet niemals aufsammeln soll
        }
        Whitelist: {
          Label: Magnet-Whitelist
          Tooltip: Anpassen, welche Gegenstände der Magnet immer aufsammeln soll
        }
        FilterListMode: {
          Label: Listenmodus-Umschalter
          Tooltip: Ändern, um auszuwählen, welche Liste für den Gegenstandsfilter verwendet wird
        }
        Buff: {
          Label: Buff
          Tooltip: Umschalten, ob der Magnet einen Buff gewährt, wenn er aktiv ist
        }
        Held: {
          Label: Gehalten
          Tooltip: Umschalten, ob der Magnet nur funktioniert, wenn er gehalten wird (statt sich im Inventar zu befinden)
        }
        OnEnter: {
          Label: Aktivieren beim Betreten
          Tooltip: Umschalten, ob der Magnet automatisch aktiviert wird, wenn die Welt betreten wird
        }
        NeedsSpace: {
          Label: Benötigt Platz
          Tooltip: Umschalten, ob der Magnet nur funktioniert, wenn im Inventar Platz ist
        }
        Instant: {
          Label: Sofort
          Tooltip: Umschalten, ob Gegenstände sich teleportieren anstatt zu dir zu fliegen – Dies ignoriert jegliche Geschwindigkeit/Beschleunigung, aber nicht die Reichweite
        }
        Range: {
          Label: Reichweite
          Tooltip: Basis-Magnetradius in Kacheln
        }
        Velocity: {
          Label: Geschwindigkeit
          Tooltip: Geschwindigkeit, mit der Gegenstände zu dir gezogen werden
        }
        Acceleration: {
          Label: Beschleunigung
          Tooltip: Wie schnell ein Gegenstand seine maximale Geschwindigkeit erreicht
        }
        ScaleMode: {
          Label: Skalierung
          Tooltip: Skalierungsmodus
        }
        CurrentMaxRange: {
          Label: Ergebnis-Maximalreichweite
          Tooltip: ""
        }
        CurrentVelocity: {
          Label: Ergebnis-Geschwindigkeit
          Tooltip: ""
        }
        CurrentAcceleration: {
          Label: Ergebnis-Beschleunigung
          Tooltip: ""
        }
      }
      FilterListModeType: {
        Tooltip: ""
        Blacklist.Label: Blacklist
        Whitelist.Label: Whitelist
      }
      ScaleModeType: {
        Tooltip: ""
        Bosses.Label: Erhöht sich mit Bossen
        AlwaysMaxRange.Label: Bosse + Maximale Reichweite
        OnlyConfig.Label: Benutzerdefiniert + Maximale Reichweite
      }
    }
  }
}
